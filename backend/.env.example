# Copy to .env and fill in from the hackathon API details page. Never commit .env.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# If the page gives a plain OpenAI-compatible base URL instead, use these and leave the Azure lines empty:
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Free key from finnhub.io (takes a minute to sign up)
FINNHUB_API_KEY=

# Set to 1 after one successful run so the demo replays saved data if Wi-Fi fails
USE_CACHE=0
